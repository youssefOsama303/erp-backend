# ══════════════════════════════════════════════════════════════════════
# Nexus ERP — PRODUCTION Environment Variables Template
# ══════════════════════════════════════════════════════════════════════
# 1. Copy this to .env  (NEVER commit .env to git)
# 2. Replace ALL placeholder values before deploying
# 3. Run: node -e "require('crypto').randomBytes(48).then(b=>console.log(b.toString('hex')))"
#    to generate JWT_SECRET
# ══════════════════════════════════════════════════════════════════════

# ── SERVER ─────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
# Remove EWM_SEED in production! (only needed for local dev seeding)
# EWM_SEED=true

# ── DATABASE ────────────────────────────────────────────────────────
# Replace with your production PostgreSQL URL (Neon, Supabase, RDS, etc.)
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require"
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000

# ── AUTH — CRITICAL ─────────────────────────────────────────────────
# MUST be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING_GENERATED_BY_NODE_CRYPTO

# ── CORS — Lock down to your frontend domain(s) ─────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CLIENT_URL=https://your-erp-domain.com,https://admin.your-erp-domain.com

# ── RATE LIMITING ────────────────────────────────────────────────────
# Already configured in server.js (10 req / 15min on /api/auth)
# Optional: tighten API-wide rate limit
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=900000

# ── STRIPE PAYMENTS ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ── PAYMOB ──────────────────────────────────────────────────────────
PAYMOB_API_KEY=YOUR_PAYMOB_LIVE_API_KEY
PAYMOB_INTEGRATION_ID=YOUR_INTEGRATION_ID
PAYMOB_IFRAME_ID=YOUR_IFRAME_ID

# ── SHIPENGINE ──────────────────────────────────────────────────────
SHIPENGINE_API_KEY=LIVE_YOUR_KEY_HERE

# ── ADMIN ────────────────────────────────────────────────────────────
ADMIN_DEFAULT_NAME=Your Admin Name
