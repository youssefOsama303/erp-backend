# ══════════════════════════════════════════════════════════════
# ERP Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════

# ── SERVER ───────────────────────────────────────────────────
PORT=5502
NODE_ENV=production


# ── DATABASE: Local PostgreSQL ───────────────────────────────
# This project is configured to run strictly locally.
#
# Set both DATABASE_URL (app runtime) and DIRECT_URL (migrations) to the same local connection.
DATABASE_URL="postgresql://postgres:123456@localhost:5432/erp_local"
DIRECT_URL="postgresql://postgres:password@localhost:5432/erp_local"

# ── Connection Pool Tuning (optional, defaults shown) ────────
# Keep DB_POOL_MAX low (2–5) for serverless to avoid exhausting Neon connections
DB_POOL_MAX=3
DB_IDLE_TIMEOUT=10000
DB_CONN_TIMEOUT=5502


# ── JWT AUTHENTICATION ────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters


# ── CORS ─────────────────────────────────────────────────────
CLIENT_URL=https://your-frontend-domain.com


# ── STRIPE PAYMENTS ──────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_or_sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret


# ── PAYMOB (Egyptian Payment Gateway) ────────────────────────
# Get from: https://accept.paymob.com/portal2/en/settings
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID=your_integration_id
PAYMOB_IFRAME_ID=your_iframe_id


# ── SHIPENGINE (Shipping Rates) ───────────────────────────────
# Get from: https://app.shipengine.com/settings/api-keys
SHIPENGINE_API_KEY=TEST_or_LIVE_your_shipengine_api_key
